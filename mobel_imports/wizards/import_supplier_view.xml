<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_supplier_form" model="ir.ui.view">
        <field name="name">import.supplier.wizard.form</field>
        <field name="model">import.supplier.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Proveedores">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_supplier" model="ir.actions.act_window">
        <field name="name">Importar Proveedores</field>
        <field name="res_model">import.supplier.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
