<odoo>
    <record id="view_import_account_move_form" model="ir.ui.view">
        <field name="name">import.account.move.form</field>
        <field name="model">import.account.move</field>
        <field name="arch" type="xml">
            <form string="Importar Movimientos Contable">
                <group>
                    <field name="journal_id"/>
                    <field name="data_file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Importar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_account_move" model="ir.actions.act_window">
        <field name="name">Importar Movimientos Contable</field>
        <field name="res_model">import.account.move</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_account_move"
              name="Importar Movimientos Contable"
              parent="menu_mobel_imports_accounting_root"
              action="action_import_account_move"
              sequence="20"/>
</odoo>
