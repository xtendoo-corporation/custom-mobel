<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_customer_form" model="ir.ui.view">
        <field name="name">import.customer.wizard.form</field>
        <field name="model">import.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Clientes">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_customer" model="ir.actions.act_window">
        <field name="name">Importar Clientes</field>
        <field name="res_model">import.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
